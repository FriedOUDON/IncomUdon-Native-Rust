import { Button, CheckBox, ComboBox, LineEdit, SpinBox } from "std-widgets.slint";

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    height: 46px;
    background: selected ? #dce8ff : #00000000;
    border-radius: 22px;

    Text {
        x: 18px;
        width: parent.width - 36px;
        vertical-alignment: center;
        text: root.label;
        color: selected ? #173b75 : #263238;
        font-size: 15px;
        font-weight: selected ? 700 : 500;
    }
    TouchArea { clicked => { root.activated(); } }
}

export component AppWindow inherits Window {
    title: "IncomUdon";
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 760px;
    background: #f7f9fc;

    in-out property <int> current-page: 0;
    in-out property <string> profile-name: "Default";
    in-out property <string> channel-id: "0";
    in-out property <string> sender-id: "0";
    in-out property <string> connection-status: "Disconnected";
    in-out property <string> active-talker: "No active speaker";
    in-out property <bool> receive-only: false;
    in-out property <bool> mute-self-id: true;
    in-out property <int> codec-index: 0;
    in-out property <int> bitrate-bps: 16000;
    in-out property <string> profile-save-status: "";
    in-out property <string> relay-host: "127.0.0.1";
    in-out property <int> relay-port: 50000;
    in-out property <bool> force-ipv4: false;

    callback ptt-pressed();
    callback ptt-released();
    callback profile-value-changed();
    callback save-profile();
    callback save-relay-settings();
    callback connect-relay();
    callback disconnect-relay();

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 244px;
            background: #ffffff;
            border-color: #d9e1e8;
            border-width: 1px;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                Text {
                    text: "IncomUdon";
                    height: 48px;
                    vertical-alignment: center;
                    font-size: 25px;
                    font-weight: 800;
                    color: #153a70;
                }
                Text {
                    text: "Native Rust preview";
                    height: 24px;
                    color: #617080;
                    font-size: 12px;
                }
                Rectangle { height: 18px; background: #00000000; }
                NavigationItem {
                    label: "PTT";
                    selected: root.current-page == 0;
                    activated => { root.current-page = 0; }
                }
                NavigationItem {
                    label: "Profiles";
                    selected: root.current-page == 1;
                    activated => { root.current-page = 1; }
                }
                NavigationItem {
                    label: "General settings";
                    selected: root.current-page == 2;
                    activated => { root.current-page = 2; }
                }
                NavigationItem {
                    label: "Licenses";
                    selected: root.current-page == 3;
                    activated => { root.current-page = 3; }
                }
                Rectangle { vertical-stretch: 1; background: #00000000; }
                Text {
                    text: "Protocol v1 / AES-GCM v2";
                    color: #617080;
                    font-size: 12px;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 28px;
                spacing: 18px;

                Text {
                    text: root.current-page == 0 ? "Push to Talk" :
                          root.current-page == 1 ? "Profile settings" :
                          root.current-page == 2 ? "General settings" : "Licenses";
                    color: #1a2938;
                    font-size: 30px;
                    font-weight: 800;
                }

                if root.current-page == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;
                    HorizontalLayout {
                        spacing: 18px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #ffffff;
                            border-color: #d9e1e8;
                            border-width: 1px;
                            border-radius: 14px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Text { text: "Current profile"; font-size: 18px; font-weight: 700; color: #263238; }
                                Text { text: root.profile-name; font-size: 23px; font-weight: 700; color: #153a70; }
                                Text { text: "Channel " + root.channel-id + " / Sender " + root.sender-id; color: #4b5b6a; }
                                ComboBox { model: [root.profile-name]; current-index: 0; }
                                Rectangle { vertical-stretch: 1; background: #00000000; }
                                Text { text: "Status"; color: #617080; font-size: 13px; }
                                Text { text: root.connection-status; color: #0d6b45; font-size: 18px; font-weight: 700; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Connect"; primary: true; clicked => { root.connect-relay(); } }
                                    Button { text: "Disconnect"; clicked => { root.disconnect-relay(); } }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 2;
                            background: #ffffff;
                            border-color: #d9e1e8;
                            border-width: 1px;
                            border-radius: 14px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 18px;
                                Text {
                                    text: root.receive-only ? "Receive-only mode" : "Hold to transmit";
                                    horizontal-alignment: center;
                                    color: #4b5b6a;
                                    font-size: 18px;
                                }
                                Rectangle { vertical-stretch: 1; background: #00000000; }
                                Rectangle {
                                    width: 270px;
                                    height: 270px;
                                    border-radius: self.width / 2;
                                    background: root.receive-only ? #cbd2da : #d93025;
                                    Text {
                                        text: root.receive-only ? "RX ONLY" : "PTT";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        color: #ffffff;
                                        font-size: 48px;
                                        font-weight: 800;
                                    }
                                    TouchArea {
                                        enabled: !root.receive-only;
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                root.ptt-pressed();
                                            }
                                            if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                                                root.ptt-released();
                                            }
                                        }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: #00000000; }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #ffffff;
                            border-color: #d9e1e8;
                            border-width: 1px;
                            border-radius: 14px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Text { text: "Active speaker"; font-size: 18px; font-weight: 700; color: #263238; }
                                Text { text: root.active-talker; font-size: 18px; font-weight: 700; color: #153a70; wrap: word-wrap; }
                                Rectangle { vertical-stretch: 1; background: #00000000; }
                                Text { text: "Network and audio metrics will appear here."; wrap: word-wrap; color: #617080; }
                            }
                        }
                    }
                }

                if root.current-page == 1 : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;
                    VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            height: 382px;
                            background: #ffffff;
                            border-color: #d9e1e8;
                            border-width: 1px;
                            border-radius: 14px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Profile identity"; height: 28px; font-size: 18px; font-weight: 700; color: #263238; }
                                HorizontalLayout {
                                    height: 42px;
                                    spacing: 12px;
                                    Text { width: 150px; text: "Profile name"; vertical-alignment: center; color: #4b5b6a; }
                                    LineEdit { height: 34px; horizontal-stretch: 1; text <=> root.profile-name; edited => { root.profile-value-changed(); } }
                                }
                                HorizontalLayout {
                                    height: 42px;
                                    spacing: 12px;
                                    Text { width: 150px; text: "Channel ID"; vertical-alignment: center; color: #4b5b6a; }
                                    LineEdit { height: 34px; horizontal-stretch: 1; text <=> root.channel-id; edited => { root.profile-value-changed(); } }
                                }
                                HorizontalLayout {
                                    height: 42px;
                                    spacing: 12px;
                                    Text { width: 150px; text: "Sender ID"; vertical-alignment: center; color: #4b5b6a; }
                                    LineEdit { height: 34px; horizontal-stretch: 1; text <=> root.sender-id; edited => { root.profile-value-changed(); } }
                                }
                                Rectangle { height: 1px; background: #d9e1e8; }
                                Text { text: "Audio"; height: 28px; font-size: 18px; font-weight: 700; color: #263238; }
                                HorizontalLayout {
                                    height: 42px;
                                    spacing: 12px;
                                    Text { width: 150px; text: "Codec"; vertical-alignment: center; color: #4b5b6a; }
                                    ComboBox {
                                        horizontal-stretch: 1;
                                        model: ["Opus", "Codec2", "PCM"];
                                        current-index <=> root.codec-index;
                                        selected => { root.profile-value-changed(); }
                                    }
                                }
                                HorizontalLayout {
                                    height: 42px;
                                    spacing: 12px;
                                    Text { width: 150px; text: "Bitrate (bps)"; vertical-alignment: center; color: #4b5b6a; }
                                    SpinBox {
                                        horizontal-stretch: 1;
                                        value <=> root.bitrate-bps;
                                        minimum: 700;
                                        maximum: 32000;
                                        enabled: root.codec-index != 2;
                                        edited => { root.profile-value-changed(); }
                                    }
                                }
                                HorizontalLayout {
                                    height: 34px;
                                    spacing: 20px;
                                    Rectangle { width: 150px; background: #00000000; }
                                    CheckBox { text: "Receive-only"; checked <=> root.receive-only; toggled => { root.profile-value-changed(); } }
                                    CheckBox { text: "Mute self ID"; checked <=> root.mute-self-id; toggled => { root.profile-value-changed(); } }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 42px;
                            spacing: 12px;
                            Button { text: "Save profile"; primary: true; clicked => { root.save-profile(); } }
                            Text { text: root.profile-save-status; vertical-alignment: center; color: #4b5b6a; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                        Rectangle { vertical-stretch: 1; background: #00000000; }
                    }
                }
                if root.current-page == 2 : Rectangle {
                    vertical-stretch: 1;
                    background: #ffffff;
                    border-color: #d9e1e8;
                    border-width: 1px;
                    border-radius: 14px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        Text { text: "Relay connection"; font-size: 18px; font-weight: 700; color: #263238; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                Text { text: "Relay host"; color: #4b5b6a; }
                                LineEdit { text <=> root.relay-host; }
                            }
                            VerticalLayout {
                                Text { text: "Relay port"; color: #4b5b6a; }
                                SpinBox { value <=> root.relay-port; minimum: 1; maximum: 65535; }
                            }
                            VerticalLayout {
                                Rectangle { height: 18px; background: #00000000; }
                                CheckBox { text: "Force IPv4"; checked <=> root.force-ipv4; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Button { text: "Save relay settings"; primary: true; clicked => { root.save-relay-settings(); } }
                            Text { text: root.profile-save-status; vertical-alignment: center; color: #4b5b6a; }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                        }
                        Text { text: "Device, button mapping, and lock settings will be added here."; wrap: word-wrap; color: #4b5b6a; }
                    }
                }

                if root.current-page == 3 : Rectangle {
                    vertical-stretch: 1;
                    background: #ffffff;
                    border-color: #d9e1e8;
                    border-width: 1px;
                    border-radius: 14px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        Text { text: "Third-party licenses"; font-size: 18px; font-weight: 700; color: #263238; }
                        Text { text: "MIT application license. Third-party license rendering is scheduled for a later milestone."; wrap: word-wrap; color: #4b5b6a; }
                    }
                }
            }
        }
    }
}
